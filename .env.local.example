# Copiá este archivo a .env.local y completá con los valores de tu proyecto
# (Supabase Dashboard > Project Settings > API).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional: usada como base para el link de confirmación de email.
# En local podés dejarla sin definir (usa http://localhost:3000 por defecto).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
